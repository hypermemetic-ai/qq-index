{
  "name": "@hypermemetic-ai/qq-index",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bounded repository orientation in README.md.",
  "main": "src/plugin.mjs",
  "exports": {
    ".": "./src/plugin.mjs",
    "./session-index-client": "./src/session-index-client.mjs",
    "./session-index-dsh-source": "./src/session-index-dsh-source.mjs",
    "./session-index-runtime": "./src/session-index-runtime.mjs",
    "./session-index-launcher": "./src/session-index-launcher.mjs"
  },
  "files": [
    "bin/",
    "benchmarks/",
    "config/",
    "docs/",
    "systemd/",
    "src/",
    "prompts/",
    "README.md"
  ],
  "scripts": {
    "test": "node tests/plugin.mjs && node tests/session-index-runtime.mjs && node tests/session-index-launcher.mjs && node tests/session-index-dsh-production.mjs && node tests/index.mjs && node tests/harvest.mjs && node tests/history-shadow.mjs && node tests/session-history-benchmark.mjs && node tests/writer-boot.mjs && node tests/refresh.mjs && npm run test:session-index-dsh-e2e && npm run test:session-index-e2e",
    "benchmark:session-history": "python3 benchmarks/session_history_fts5.py",
    "benchmark:session-history:scaled": "python3 benchmarks/session_history_fts5.py --mode scaled",
    "rust:fmt": "cargo fmt --check",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace",
    "daemon:build": "cargo build --package qq-session-indexd --bin qq-session-indexd",
    "daemon:test": "cargo test --package qq-session-indexd",
    "test:session-index-e2e": "node tests/session-index-client.e2e.mjs",
    "test:session-index-dsh-e2e": "node tests/session-index-dsh-source.e2e.mjs"
  },
  "bin": {
    "qq-index-refresh": "bin/qq-index-refresh",
    "qq-index-history-shadow": "bin/qq-index-history-shadow",
    "qq-session-indexd-launch": "bin/qq-session-indexd-launch"
  },
  "dependencies": {
    "@deepseek-ai/dsh-session-query": "0.1.0-rc.7"
  }
}

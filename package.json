{
  "name": "@hypermemetic-ai/qq-index",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bounded repository orientation in README.md.",
  "main": "src/plugin.mjs",
  "exports": {
    ".": "./src/plugin.mjs"
  },
  "files": [
    "bin/",
    "benchmarks/",
    "config/",
    "docs/",
    "systemd/",
    "src/",
    "prompts/",
    "README.md"
  ],
  "scripts": {
    "test": "node tests/plugin.mjs && node tests/index.mjs && node tests/harvest.mjs && node tests/history-shadow.mjs && node tests/session-history-benchmark.mjs && node tests/writer-boot.mjs && node tests/refresh.mjs",
    "benchmark:session-history": "python3 benchmarks/session_history_fts5.py",
    "benchmark:session-history:scaled": "python3 benchmarks/session_history_fts5.py --mode scaled"
  },
  "bin": {
    "qq-index-refresh": "bin/qq-index-refresh",
    "qq-index-history-shadow": "bin/qq-index-history-shadow"
  }
}
